# NVIDIA NIM API (Required for Character Generation & Chat)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# MongoDB Database (Required)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=ai_characters

# Avatar Generation Providers (Optional for higher concurrency & AI tier priority)
# Tier 1: Pollinations AI API Key (leave empty for public tier)
POLLINATIONS_API_KEY=
# Tier 2: Stable Horde API Key (set your account key or leave blank for anonymous '0000000000')
STABLE_HORDE_API_KEY=

# Application Settings
DEBUG=True
